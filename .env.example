# ==============================================================================
# KhaataWise Django Settings
# ==============================================================================
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================================================
# AI Self-Healing Server Configuration
# ==============================================================================
# AI Provider: 'gemini', 'openai_compatible', or 'mock' (offline fallback)
AI_PROVIDER=gemini

# Google Gemini API Settings (Get your key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / Ollama / Local API Settings (Optional alternative)
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Continuous Log Monitoring Settings
CHECK_INTERVAL_SECONDS=5.0
MAX_AI_ITERATIONS=15
COMMAND_TIMEOUT_SECONDS=60

# Watched Log File Addresses (Relative to repository root or absolute)
ERROR_LOG_PATH=logs/error.log
INPUT_LOG_PATH=logs/input.log
OUTPUT_LOG_PATH=logs/output.log
SERVER_LOG_PATH=logs/server.log

# System Prompt File Path
SYSTEM_PROMPT_PATH=system.txt

# Server Bind Address
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
